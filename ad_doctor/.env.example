# AI/research providers. Keep real keys in Render Environment, never in code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_ENDPOINT=https://api.perplexity.ai/v1/sonar

# Current database engine: SQLite.
# Local and Render Free default:
AD_DOCTOR_DATABASE_PATH=database/ad_doctor.db
# Paid Render persistent disk value:
# AD_DOCTOR_DATABASE_PATH=/opt/render/project/src/ad_doctor_data/ad_doctor.db

# DATABASE_URL is not required until the app is migrated from SQLite to PostgreSQL.

# Draft storage:
# - sqlite: read drafts from the local SQLite database.
# - google: create draft Google Docs and index them in Google Sheets.
AD_DOCTOR_DRAFT_STORE=google
AD_DOCTOR_CLEAR_SQLITE_GENERATED_DATA_FOR_GOOGLE=0
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRAFTS_SPREADSHEET_ID=
GOOGLE_DRAFTS_WORKSHEET_NAME=Drafts
GOOGLE_DRAFTS_FOLDER_ID=

# Scheduler modes:
# - worker: Render runs start_render.py, which supervises Streamlit plus a separate scheduler worker process.
# - external: GitHub Actions or another cron owns the daily job.
# - app: local/dev Streamlit process runs the app scheduler.
AD_DOCTOR_APP_SCHEDULER_ENABLED=0
AD_DOCTOR_SCHEDULER_MODE=worker
AD_DOCTOR_SCHEDULER_POLL_SECONDS=30
AD_DOCTOR_SCHEDULER_CATCHUP_HOURS=24
AD_DOCTOR_WORKER_STALE_SECONDS=900
AD_DOCTOR_JOB_TIMEOUT_SECONDS=10800

# Optional email notifications.
AD_DOCTOR_SMTP_HOST=
AD_DOCTOR_SMTP_PORT=587
AD_DOCTOR_SMTP_USERNAME=
AD_DOCTOR_SMTP_PASSWORD=
AD_DOCTOR_SMTP_FROM=
AD_DOCTOR_SMTP_USE_TLS=1
